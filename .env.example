# ============================================================
#  .env.example — agw-cloud-api · CAPA 4 (Gateway lógico)
#  Copiar a .env y rellenar. NUNCA versionar el .env real.
# ============================================================

# ── Base de datos: Neon PostgreSQL ────────────────────────
# POOLED — para la función serverless (host con sufijo "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
# DIRECTO — solo para migraciones DDL y psql (host SIN "-pooler")
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# ── Token estático del Nodo Fog (Raspberry Pi) ────────────
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Debe coincidir con AGW_CLOUD_API_KEY del edge.
API_TOKEN=

# ── JWT del dashboard (login OTP passwordless) ────────────
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# ── SMTP para el código OTP ───────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3652
ALLOWED_ORIGINS=["http://localhost:3652"]

# ── Aplicación ────────────────────────────────────────────
APP_NAME=AGW Cloud API
APP_VERSION=2.1.0
DEBUG=false

# ── IA: NVIDIA Nemotron (Fase 6) ──────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=nvidia/nemotron-nano-9b-v2
NVIDIA_MODEL_DEEP=nvidia/llama-3.3-nemotron-super-49b-v1.5

# ══════════════════════════════════════════════════════════
#  Solo para agw-cloud-api/app/ — backend HUÉRFANO, no
#  desplegado (MCD §7.2). Ignorar salvo que se reactive.
# ══════════════════════════════════════════════════════════
# SECRET_KEY=
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7
# EDGE_GATEWAY_TOKEN=

# Correo transaccional (Resend). Dominio verificado obligatorio.
RESEND_API_KEY=
RESEND_FROM=VitalCrop <vitalcrop@tu-dominio.com>
